{
  "redirects": [
    { "source": "/theboxtop", "destination": "/theboxtop/launch/", "permanent": false },
    { "source": "/theboxtop/", "destination": "/theboxtop/launch/", "permanent": false },
    { "source": "/boxtop", "destination": "/theboxtop/launch/?utm_source=vanity&utm_medium=offline&utm_campaign=boxtop_launch", "permanent": false },
    { "source": "/boxtop/", "destination": "/theboxtop/launch/?utm_source=vanity&utm_medium=offline&utm_campaign=boxtop_launch", "permanent": false },
    { "source": "/BoxTop", "destination": "/theboxtop/launch/?utm_source=vanity&utm_medium=offline&utm_campaign=boxtop_launch", "permanent": false },
    { "source": "/Boxtop", "destination": "/theboxtop/launch/?utm_source=vanity&utm_medium=offline&utm_campaign=boxtop_launch", "permanent": false },
    { "source": "/BOXTOP", "destination": "/theboxtop/launch/?utm_source=vanity&utm_medium=offline&utm_campaign=boxtop_launch", "permanent": false },
    { "source": "/TheBoxTop", "destination": "/theboxtop/launch/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/theboxtop/launch/box-top-launch.ics",
      "headers": [{ "key": "Content-Type", "value": "text/calendar; charset=utf-8" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
